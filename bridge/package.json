{
  "name": "premiere-claude-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local bridge for Claude-in-Premiere: WebSocket hub to the Premiere panel + MCP server + Claude chat agent.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "premiere-claude-bridge": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "serve": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tools": "tsx src/print-tools.ts",
    "smoke": "tsx src/smoke-mcp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

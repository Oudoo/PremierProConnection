# ── Claude in Premiere — bridge configuration ───────────────────────────────
# Copy this file to ".env" and fill in values. The .env file is gitignored.

# Your Anthropic (Claude) API key. ONLY needed for the in-panel chat mode.
# If you only drive Premiere from an IDE over MCP (using that tool's own Claude
# subscription), you can leave this blank — see docs/COST.md.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# How Claude should address you in the panel (greeting + in chat). Optional.
USER_NAME=Oudo

# Model used by the in-panel chat agent. Opus 4.8 is the most capable.
CLAUDE_MODEL=claude-opus-4-8

# Effort for the chat agent: low | medium | high | xhigh | max  (higher = smarter/costlier)
# xhigh is a good default for agentic editing on Opus 4.8.
CLAUDE_EFFORT=high

# Network binding. Keep on localhost unless you know what you're doing.
HOST=127.0.0.1

# Port for the MCP server (Streamable HTTP) + health endpoint.
HTTP_PORT=3030

# Port the Premiere panel connects to over WebSocket.
WS_PORT=3031

# Where exported frames/thumbnails are written so Claude can "see" them.
# Defaults to a .scratch folder next to the bridge.
SCRATCH_DIR=

# Max images sent back to Claude per single tool result (vision cost guard).
MAX_VISION_IMAGES=2

# Require confirmation in the panel before destructive actions
# (delete/ripple-delete/overwrite). true | false
CONFIRM_DESTRUCTIVE=true
